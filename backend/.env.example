PORT=3000
MONGO_URI=mongodb://127.0.0.1:27017/workly
JWT_SECRET=
FRONTEND_URL=http://localhost:5173
AUTO_SEED=false

# Proxies reversos autorizados a informar o IP do cliente (X-Forwarded-For), usado nos limites de
# tentativas de login e cadastro. Liste endereços, sub-redes ou presets (loopback, linklocal, uniquelocal),
# separados por vírgula. Vazio: nenhum proxy é confiável e o cabeçalho é ignorado (acesso direto).
# "true" e números são recusados. O proxy precisa sobrescrever o cabeçalho, como em frontend/deploy/.
# TRUST_PROXY=

# Sessão do navegador: cookie HttpOnly "workly_sessao" (24 h, SameSite=Strict, Path=/api).
# Sem a variável, o cookie é Secure quando a requisição chega por HTTPS (req.secure, que depende de TRUST_PROXY
# e do X-Forwarded-Proto do proxy). Em produção com HTTPS terminado antes do nginx, defina COOKIE_SECURE=true.
# A API precisa estar na mesma origem do frontend (como no nginx do Docker e no proxy do Vite).
# COOKIE_SECURE=

# Recuperação de senha. Ainda não há provedor de e-mail: sem canal de entrega, a solicitação responde
# "indisponível". Só no desenvolvimento local, com NODE_ENV=development E a linha abaixo descomentada,
# o link de redefinição é escrito no console do servidor. Nunca use isso em produção.
# PASSWORD_RESET_DEV_LINK=console
# Endereço do frontend usado no link (padrão: FRONTEND_URL ou http://localhost:5173).
# PASSWORD_RESET_URL_BASE=http://localhost:5173

# Backup e restore: npm run backup / npm run restore. O restore substitui dados e exige confirmação.
# O restore só aceita bases workly_test_*. Para outra base, defina o nome exato dela apenas no comando
# do restore, nunca de forma permanente aqui.
# WORKLY_RESTORE_BASE_LIBERADA=
